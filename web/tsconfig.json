{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@javaabu/onu": ["../packages/onu/src/index.ts"],
      "@javaabu/onu/*": ["../packages/onu/src/*/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
