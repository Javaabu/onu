{
  "name": "onu-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "build:web": "pnpm --filter onu-web build",
    "dev": "pnpm --filter onu-web dev",
    "test": "pnpm --filter \"./packages/*\" test",
    "test:coverage": "pnpm --filter @javaabu/onu test:coverage",
    "typecheck": "pnpm -r --filter \"!./templates/*\" typecheck",
    "build:templates": "pnpm --filter \"./templates/*\" build",
    "typecheck:templates": "pnpm --filter \"./templates/*\" typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "figma:plugin": "pnpm --filter onu-figma build:plugin",
    "figma:test": "pnpm --filter onu-figma test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
