{
  "name": "@javaabu/onu-mcp",
  "version": "0.1.0",
  "description": "MCP server for Onu (@javaabu/onu): gives AI assistants the component docs and the rules for writing Onu code.",
  "license": "MIT",
  "author": {
    "name": "Javaabu Pvt. Ltd.",
    "url": "https://javaabu.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Javaabu/onu.git",
    "directory": "packages/onu-mcp"
  },
  "homepage": "https://github.com/Javaabu/onu/tree/main/packages/onu-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "onu",
    "javaabu",
    "react",
    "ui"
  ],
  "type": "module",
  "bin": {
    "onu-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node ../../scripts/llms.mjs --out data && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
